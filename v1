task.spawn(function()
    while task.wait(0.15) do
        if AutoFarm then
            pcall(function()
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local q = GetQ()
                local qGui = LP.PlayerGui.Main:FindFirstChild("Quest")
                local hasQ = qGui and qGui.Visible and qGui.Container.QuestTitle.Title.Text ~= ""

                if not hasQ then
                    if (hrp.Position - q.Npc.Position).Magnitude > 12 then 
                        FlyTo(q.Npc)
                    else 
                        StopFly()
                        hrp.CFrame = q.Npc
                        task.wait(0.2)
                        RS.Remotes.CommF_:InvokeServer("StartQuest", q.QName, q.QNum) 
                    end
                else
                    local mob, minD = nil, math.huge
                    if workspace:FindFirstChild("Enemies") then
                        for _, v in pairs(workspace.Enemies:GetChildren()) do
                            if (v.Name == q.MName or v.Name:find(q.MName)) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                                local d = (v.HumanoidRootPart.Position - hrp.Position).Magnitude
                                if d < minD then minD = d; mob = v end
                            end
                        end
                    end
                    if not mob then 
                        FlyTo(q.Mob)
                    else
                        StopFly()
                        local mHrp = mob.HumanoidRootPart
                        -- Khóa vị trí ngay sát đầu quái
                        hrp.CFrame = mHrp.CFrame * CFrame.new(0, 5, 1)
                        if BringMob then
                            for _, om in pairs(workspace.Enemies:GetChildren()) do
                                if om.Name == mob.Name and om:FindFirstChild("HumanoidRootPart") and om:FindFirstChild("Humanoid") and om.Humanoid.Health > 0 then
                                    if (om.HumanoidRootPart.Position - mHrp.Position).Magnitude <= 120 then
                                        om.HumanoidRootPart.CFrame = mHrp.CFrame
                                        om.HumanoidRootPart.CanCollide = false
                                        om.Humanoid.WalkSpeed = 0
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

