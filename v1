local Lines = {}

RSvc.RenderStepped:Connect(function()
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    
    -- Xóa Line cũ
    for _, l in pairs(Lines) do pcall(function() l:Remove() end) end
    Lines = {}

    -- 1. ESP Players
    for _, p in pairs(P:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local char = p.Character
            local pHrp = char.HumanoidRootPart

            -- ESP Box (Highlight)
            if ESPBox then
                local hl = char:FindFirstChild("JolibeeHL") or Instance.new("Highlight", char)
                hl.Name = "JolibeeHL"
                hl.Enabled = true
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            elseif char:FindFirstChild("JolibeeHL") then
                char.JolibeeHL.Enabled = false
            end

            -- ESP Name & Distance
            local bg = pHrp:FindFirstChild("PlayerESP") or Instance.new("BillboardGui", pHrp)
            bg.Name = "PlayerESP"
            bg.Size = UDim2.new(0, 150, 0, 40)
            bg.AlwaysOnTop = true
            bg.StudsOffset = Vector3.new(0, 3, 0)
            bg.Enabled = ESPName or ESPDist

            local txt = bg:FindFirstChild("Txt") or Instance.new("TextLabel", bg)
            txt.Name = "Txt"
            txt.Size = UDim2.new(1,0,1,0)
            txt.BackgroundTransparency = 1
            txt.TextColor3 = Color3.fromRGB(0, 255, 255)
            txt.TextSize = 13
            txt.Font = Enum.Font.SourceSansBold

            local str = ""
            if ESPName then str = str .. p.Name end
            if ESPDist and myHrp then
                local dist = math.floor((pHrp.Position - myHrp.Position).Magnitude)
                str = str .. (ESPName and "\n" or "") .. "[" .. dist .. "m]"
            end
            txt.Text = str

            -- ESP Line
            if ESPLine and myHrp then
                local pos, vis = Cam:WorldToViewportPoint(pHrp.Position)
                if vis then
                    local l = Drawing.new("Line")
                    l.From = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y)
                    l.To = Vector2.new(pos.X, pos.Y)
                    l.Color = Color3.fromRGB(0, 255, 255)
                    l.Thickness = 1.5
                    l.Visible = true
                    table.insert(Lines, l)
                end
            end
        end
    end
end)

