-- FIX AUTO FARM LEVEL (Tự động nhận Quest + Teleport chuẩn)
task.spawn(function()
    while task.wait(0.1) do
        if AutoFarmLevel then
            pcall(function()
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local q = GetQuest()
                local questGui = LocalPlayer.PlayerGui.Main:FindFirstChild("Quest")
                
                -- Chưa nhận nhiệm vụ -> Bay đến NPC nhận Quest
                if not questGui or not questGui.Visible or questGui.Container.QuestTitle.Title.Text == "" then
                    if (hrp.Position - q.NpcPos.Position).Magnitude > 15 then
                        SmoothFlyTo(q.NpcPos)
                    else
                        StopSmoothFly()
                        hrp.CFrame = q.NpcPos
                        task.wait(0.2)
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", q.QuestName, q.QuestNum)
                    end
                else
                    -- Đã có Quest -> Đi tìm quái
                    local mainMob, minD = nil, math.huge
                    for _, v in pairs(workspace.Enemies:GetChildren()) do
                        if (v.Name == q.MobName or v.Name:find(q.MobName)) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                            local d = (v.HumanoidRootPart.Position - hrp.Position).Magnitude
                            if d < minD then minD = d; mainMob = v end
                        end
                    end

                    if not mainMob then
                        SmoothFlyTo(q.MobPos)
                    else
                        StopSmoothFly()
                        local mobHrp = mainMob.HumanoidRootPart
                        -- Khóa vị trí nhân vật trên đầu quái
                        hrp.CFrame = mobHrp.CFrame * CFrame.new(0, 9, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        hrp.Velocity = Vector3.zero

                        -- Gom quái xung quanh ép dưới đất
                        if BringMob or AutoFarmLevel then
                            for _, om in pairs(workspace.Enemies:GetChildren()) do
                                if om.Name == mainMob.Name and om:FindFirstChild("HumanoidRootPart") and om:FindFirstChild("Humanoid") and om.Humanoid.Health > 0 then
                                    if (om.HumanoidRootPart.Position - mobHrp.Position).Magnitude <= 250 then
                                        om.HumanoidRootPart.CFrame = mobHrp.CFrame
                                        om.HumanoidRootPart.CanCollide = false
                                        om.Humanoid.WalkSpeed = 0
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

