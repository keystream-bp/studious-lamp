local NetEvent = ReplicatedStorage:FindFirstChild("RigControllerEvent") or ReplicatedStorage.Remotes:FindFirstChild("Validator") or ReplicatedStorage.Remotes:FindFirstChild("CommE")

task.spawn(function()
    while task.wait(0.01) do
        if AutoFarmLevel or FastAttack then
            pcall(function()
                if AntiBanMiss and math.random(1, 100) <= 12 then
                    task.wait(0.05)
                    return
                end

                local chr = LocalPlayer.Character
                local tool = chr and chr:FindFirstChildOfClass("Tool")
                local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
                if not tool or not hrp then return end

                tool:Activate()

                local hitList = {}
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                        local distance = (enemy.HumanoidRootPart.Position - hrp.Position).Magnitude
                        if distance <= 65 then
                            table.insert(hitList, enemy.HumanoidRootPart)
                        end
                    end
                end

                if #hitList > 0 and NetEvent then
                    local handle = tool:FindFirstChild("Handle") or hrp
                    NetEvent:FireServer("RegisterHit", handle, hitList)
                end
            end)
        end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if AutoFarmLevel then
            pcall(function()
                local chr = LocalPlayer.Character
                local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                local quest = GetCurrentQuest()
                local questUI = LocalPlayer.PlayerGui.Main:FindFirstChild("Quest")
                local hasQuest = questUI and questUI.Visible

                if not hasQuest then
                    SmoothFlyTo(CFrame.new(quest.NpcPos + Vector3.new(0, 3, 0)))
                    if (hrp.Position - quest.NpcPos).Magnitude < 10 then
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", quest.QuestName, 1)
                    end
                else
                    local mainMob = nil
                    local minDist = math.huge

                    for _, v in pairs(workspace.Enemies:GetChildren()) do
                        if v.Name == quest.MobName and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                            local d = (v.HumanoidRootPart.Position - hrp.Position).Magnitude
                            if d < minDist then
                                minDist = d
                                mainMob = v
                            end
                        end
                    end

                    if not mainMob then
                        SmoothFlyTo(CFrame.new(quest.MobPos + Vector3.new(0, 12, 0)))
                    else
                        local mobHrp = mainMob.HumanoidRootPart
                        hrp.CFrame = mobHrp.CFrame * CFrame.new(0, 9, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        hrp.Velocity = Vector3.zero

                        if BringMob or AutoFarmLevel then
                            for _, otherMob in pairs(workspace.Enemies:GetChildren()) do
                                if otherMob.Name == quest.MobName and otherMob:FindFirstChild("HumanoidRootPart") and otherMob:FindFirstChild("Humanoid") and otherMob.Humanoid.Health > 0 then
                                    if (otherMob.HumanoidRootPart.Position - mobHrp.Position).Magnitude <= 300 then
                                        otherMob.HumanoidRootPart.CFrame = mobHrp.CFrame
                                        otherMob.HumanoidRootPart.CanCollide = false
                                        otherMob.Humanoid.WalkSpeed = 0
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

