task.spawn(function()
    while task.wait(0.2) do
        if AutoFarmLevel or FastAttack then
            pcall(function()
                local chr = LocalPlayer.Character
                if chr and not chr:FindFirstChildOfClass("Tool") then
                    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
