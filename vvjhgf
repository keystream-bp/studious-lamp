local Lines = {}
local function ClearLines()
    for _, l in pairs(Lines) do if l then l:Remove() end end
    Lines = {}
end

local function ApplyPlayerESP(plr)
    if plr == LocalPlayer then return end
    local function SetupChr(chr)
        if not chr then return end
        local hrp = chr:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end

        local hl = chr:FindFirstChild("JolibeeHighlight") or Instance.new("Highlight")
        hl.Name = "JolibeeHighlight"
        hl.Adornee = chr
        hl.FillTransparency = 0.5
        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.Enabled = ESPBox
        hl.Parent = chr

        local bg = hrp:FindFirstChild("JolibeePlayerName") or Instance.new("BillboardGui")
        bg.Name = "JolibeePlayerName"
        bg.Adornee = hrp
        bg.Size = UDim2.new(0, 150, 0, 40)
        bg.StudsOffset = Vector3.new(0, 3, 0)
        bg.AlwaysOnTop = true
        bg.Enabled = ESPName or ESPDistance

        local txt = bg:FindFirstChild("Txt") or Instance.new("TextLabel", bg)
        txt.Name = "Txt"
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextColor3 = Color3.fromRGB(0, 255, 255)
        txt.TextStrokeTransparency = 0
        txt.TextSize = 13
        txt.Font = Enum.Font.SourceSansBold
        txt.Parent = bg
        bg.Parent = hrp

        local boneHl = chr:FindFirstChild("JolibeeBone") or Instance.new("Highlight")
        boneHl.Name = "JolibeeBone"
        boneHl.Adornee = chr
        boneHl.FillTransparency = 1
        boneHl.OutlineColor = Color3.fromRGB(0, 255, 0)
        boneHl.Enabled = ESPBone
        boneHl.Parent = chr
    end

    if plr.Character then SetupChr(plr.Character) end
    plr.CharacterAdded:Connect(SetupChr)
end

for _, plr in pairs(Players:GetPlayers()) do ApplyPlayerESP(plr) end
Players.PlayerAdded:Connect(ApplyPlayerESP)

