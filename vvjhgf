        end
    end
end)

local Lines = {}
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hrp, hum = char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
    if FlyEnabled and hrp and hum then
        hum.PlatformStand = true
        local md = hum.MoveDirection
        hrp.Velocity = md.Magnitude > 0 and (Camera.CFrame.LookVector * -md.Z + Camera.CFrame.RightVector * md.X).Unit * FlySpeed or Vector3.zero
    elseif hum and not FlyEnabled and not AutoFarmLevel and not AutoChest and not CurrentTween then 
        hum.PlatformStand = false 
    end

    for _, l in pairs(Lines) do if l then l:Remove() end end; Lines = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local tHrp = p.Character.HumanoidRootPart
            
            if ESPBox then 
                local hl = p.Character:FindFirstChild("HL") or Instance.new("Highlight", p.Character)
                hl.Name, hl.Enabled = "HL", true 
            elseif p.Character:FindFirstChild("HL") then
                p.Character.HL.Enabled = false
            end
            
            local bg = tHrp:FindFirstChild("PlayerESP") or Instance.new("BillboardGui", tHrp)
            bg.Name, bg.Size, bg.AlwaysOnTop, bg.StudsOffset = "PlayerESP", UDim2.new(0, 150, 0, 40), true, Vector3.new(0, 3, 0)
            bg.Enabled = ESPName or ESPDistance
            
            local txt = bg:FindFirstChild("Txt") or Instance.new("TextLabel", bg)
            txt.Name, txt.Size, txt.BackgroundTransparency, txt.TextColor3, txt.TextSize, txt.Font = "Txt", UDim2.new(1,0,1,0), 1, Color3.fromRGB(0, 255, 255), 13, Enum.Font.SourceSansBold
            
            local str = ""
            if ESPName then str = str .. p.Name end
            if ESPDistance and hrp then
                local dist = math.floor((tHrp.Position - hrp.Position).Magnitude)
                str = str .. (ESPName and "\n" or "") .. "[" .. dist .. "m]"
            end
            txt.Text = str

            if ESPLine and hrp then
                local pos, vis = Camera:WorldToViewportPoint(tHrp.Position)
                if vis then
                    local l = Drawing.new("Line"); l.From, l.To, l.Color, l.Thickness, l.Visible = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y), Vector2.new(pos.X, pos.Y), Color3.new(1,1,1), 1.5, true
                    table.insert(Lines, l)
                end
            end
        end
    end
end)

