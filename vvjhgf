local function GetTargetPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
    if obj:IsA("Tool") then return obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart") end
    return nil
end

local function CreateWorldESP(obj, defaultName, color)
    local part = GetTargetPart(obj)
    if not part then return end

    local gui = part:FindFirstChild("JolibeeWorldESP")
    if not gui then
        gui = Instance.new("BillboardGui")
        gui.Name = "JolibeeWorldESP"
        gui.Size = UDim2.new(0, 200, 0, 40)
        gui.AlwaysOnTop = true

        local txt = Instance.new("TextLabel", gui)
        txt.Name = "Label"
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextColor3 = color
        txt.TextStrokeTransparency = 0
        txt.TextSize = 13
        txt.Font = Enum.Font.SourceSansBold
        txt.Text = defaultName
        gui.Parent = part
    end

    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp and gui:FindFirstChild("Label") then
        local dist = math.floor((part.Position - hrp.Position).Magnitude)
        gui.Label.Text = defaultName .. "\n[" .. dist .. "m]"
    end
end

local function RemoveWorldESP(obj)
    local part = GetTargetPart(obj)
    if part and part:FindFirstChild("JolibeeWorldESP") then
        part.JolibeeWorldESP:Destroy()
    end
end

task.spawn(function()
    while task.wait(0.4) do
        for _, obj in pairs(workspace:GetDescendants()) do
            local nameLower = string.lower(obj.Name)

            local isChest = obj:IsA("Model") and (string.find(nameLower, "chest") or string.find(nameLower, "rương"))
            if ESPChest and isChest then
                CreateWorldESP(obj, "📦 " .. obj.Name, Color3.fromRGB(255, 215, 0))
            elseif not ESPChest and isChest then
                RemoveWorldESP(obj)
            end

            local isFruit = (obj:IsA("Tool") or obj:IsA("Model")) and (string.find(nameLower, "fruit") or string.find(nameLower, "trái"))
            local isDropped = isFruit and not obj:FindFirstAncestorOfClass("Model"):FindFirstChild("Humanoid")
            if ESPFruit and isDropped then
                CreateWorldESP(obj, "🍎 " .. obj.Name, Color3.fromRGB(255, 105, 180))
            elseif not ESPFruit and isFruit then
                RemoveWorldESP(obj)
            end
        end
    end
end)

