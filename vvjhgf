local function GetLvl()
    local lvl = 1
    pcall(function() lvl = (LP:FindFirstChild("Data") and LP.Data.Level.Value) or LP.Level.Value end)
    return lvl
end

local function GetQ()
    local l, c = GetLvl(), Quests[1]
    for _, q in ipairs(Quests) do if l >= q[1] then c = q end end
    return {QName = c[2], QNum = c[3], MName = c[4], Npc = c[5], Mob = c[6]}
end

local function FlyTo(targetCF)
    local chr = LP.Character
    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
    local hum = chr and chr:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local dist = (hrp.Position - targetCF.Position).Magnitude
    if dist > 15 then
        hum.PlatformStand = true
        for _, v in pairs(chr:GetChildren()) do if v:IsA("BasePart") then v.CanCollide = false end end
        if not CurPos or (CurPos - targetCF.Position).Magnitude > 5 then
            CurPos = targetCF.Position
            if CurTween then CurTween:Cancel() end
            CurTween = TS:Create(hrp, TweenInfo.new(dist / 220, Enum.EasingStyle.Linear), {CFrame = targetCF})
            CurTween:Play()
        end
    else
        if CurTween then CurTween:Cancel(); CurTween = nil end
        CurPos, hrp.CFrame, hum.PlatformStand = nil, targetCF, false
    end
end

local function StopFly()
    if CurTween then CurTween:Cancel(); CurTween = nil end
    CurPos = nil
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum and not FlyEnabled then hum.PlatformStand = false end
end

