local function GetQuest()
    local lvl, curr = LocalPlayer.Data.Level.Value, QuestData[1]
    for _, q in ipairs(QuestData) do if lvl >= q[1] then curr = q end end
    return {Level = curr[1], QuestName = curr[2], MobName = curr[3], NpcPos = curr[4], MobPos = curr[5]}
end

local function SmoothFlyTo(target)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (hrp.Position - target.Position).Magnitude
    if dist > 15 then
        if CurrentTween then CurrentTween:Cancel() end
        CurrentTween = TweenService:Create(hrp, TweenInfo.new(dist / 250, Enum.EasingStyle.Linear), {CFrame = target})
        CurrentTween:Play()
    else hrp.CFrame = target end
end

