                else
                    local mainMob, minD = nil, math.huge
                    for _, v in pairs(workspace.Enemies:GetChildren()) do
                        if v.Name == q.MobName and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                            local d = (v.HumanoidRootPart.Position - hrp.Position).Magnitude
                            if d < minD then minD = d; mainMob = v end
                        end
                    end
                    if not mainMob then SmoothFlyTo(CFrame.new(q.MobPos + Vector3.new(0, 12, 0)))
                    else
                        local mobHrp = mainMob.HumanoidRootPart
                        hrp.CFrame = mobHrp.CFrame * CFrame.new(0, 9, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        hrp.Velocity = Vector3.zero
                        if BringMob or AutoFarmLevel then
                            for _, om in pairs(workspace.Enemies:GetChildren()) do
                                if om.Name == q.MobName and om:FindFirstChild("HumanoidRootPart") and om:FindFirstChild("Humanoid") and om.Humanoid.Health > 0 then
                                    if (om.HumanoidRootPart.Position - mobHrp.Position).Magnitude <= 300 then
                                        om.HumanoidRootPart.CFrame = mobHrp.CFrame
                                        om.HumanoidRootPart.CanCollide, om.Humanoid.WalkSpeed = false, 0
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

