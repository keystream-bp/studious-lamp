local function DrawWorldESP(obj, name, col)
    local part = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
    if not part then return end
    local gui = part:FindFirstChild("JolibeeESP") or Instance.new("BillboardGui", part)
    gui.Name, gui.Size, gui.AlwaysOnTop = "JolibeeESP", UDim2.new(0, 200, 0, 40), true
    local txt = gui:FindFirstChild("Label") or Instance.new("TextLabel", gui)
    txt.Name, txt.Size, txt.BackgroundTransparency, txt.TextColor3, txt.TextSize, txt.Font = "Label", UDim2.new(1,0,1,0), 1, col, 13, Enum.Font.SourceSansBold
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then txt.Text = name .. "\n[" .. math.floor((part.Position - hrp.Position).Magnitude) .. "m]" end
end

