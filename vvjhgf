local Tabs = {}
local FirstTab = true

local function CreateTab(tabName)
    local TabBtn = Instance.new("TextButton", TabHolder)
    TabBtn.Size = UDim2.new(1, -5, 0, 32)
    TabBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
    TabBtn.Text = tabName
    TabBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
    TabBtn.Font = Enum.Font.SourceSansBold
    TabBtn.TextSize = 14
    
    local TabCorner = Instance.new("UICorner", TabBtn)
    TabCorner.CornerRadius = UDim.new(0, 6)

    local TabContent = Instance.new("ScrollingFrame", ContentHolder)
    TabContent.Size = UDim2.new(1, 0, 1, 0)
    TabContent.BackgroundTransparency = 1
    TabContent.ScrollBarThickness = 3
    TabContent.Visible = false

    local ContentLayout = Instance.new("UIListLayout", TabContent)
    ContentLayout.Padding = UDim.new(0, 6)

    if FirstTab then
        FirstTab = false
        TabContent.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(220, 20, 60)
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.Content.Visible = false
            t.Btn.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
            t.Btn.TextColor3 = Color3.fromRGB(180, 180, 190)
        end
        TabContent.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(220, 20, 60)
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    table.insert(Tabs, {Btn = TabBtn, Content = TabContent})

    local Elements = {}

    function Elements:CreateToggle(data)
        local frame = Instance.new("Frame", TabContent)
        frame.Size = UDim2.new(1, -10, 0, 35)
        frame.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local label = Instance.new("TextLabel", frame)
        label.Text = "  " .. data.Name
        label.Size = UDim2.new(0.7, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(220, 220, 220)
        label.Font = Enum.Font.SourceSans
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left

        local btn = Instance.new("TextButton", frame)
        btn.Size = UDim2.new(0, 45, 0, 22)
        btn.Position = UDim2.new(1, -50, 0.5, -11)
        btn.BackgroundColor3 = data.CurrentValue and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 70)
        btn.Text = data.CurrentValue and "ON" or "OFF"
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 12
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        local state = data.CurrentValue or false
        btn.MouseButton1Click:Connect(function()
            state = not state
            btn.BackgroundColor3 = state and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 70)
            btn.Text = state and "ON" or "OFF"
            data.Callback(state)
        end)
    end

    function Elements:CreateButton(data)
        local btn = Instance.new("TextButton", TabContent)
        btn.Size = UDim2.new(1, -10, 0, 35)
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
        btn.Text = data.Name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 14
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        btn.MouseButton1Click:Connect(function()
            data.Callback()
        end)
    end

    function Elements:CreateSlider(data)
        local frame = Instance.new("Frame", TabContent)
        frame.Size = UDim2.new(1, -10, 0, 45)
        frame.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local label = Instance.new("TextLabel", frame)
        label.Text = "  " .. data.Name .. ": " .. tostring(data.CurrentValue)
        label.Size = UDim2.new(1, 0, 0, 20)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(220, 220, 220)
        label.Font = Enum.Font.SourceSans
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left

        local sliderBar = Instance.new("Frame", frame)
        sliderBar.Size = UDim2.new(1, -20, 0, 8)
        sliderBar.Position = UDim2.new(0, 10, 0, 26)
        sliderBar.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        Instance.new("UICorner", sliderBar)

        local sliderFill = Instance.new("Frame", sliderBar)
        local percent = (data.CurrentValue - data.Range[1]) / (data.Range[2] - data.Range[1])
        sliderFill.Size = UDim2.new(percent, 0, 1, 0)
        sliderFill.BackgroundColor3 = Color3.fromRGB(220, 20, 60)
        Instance.new("UICorner", sliderFill)

        local dragging = false
        local function UpdateSlider(input)
            local pos = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
            local val = math.floor(data.Range[1] + (data.Range[2] - data.Range[1]) * pos)
            sliderFill.Size = UDim2.new(pos, 0, 1, 0)
            label.Text = "  " .. data.Name .. ": " .. tostring(val)
            data.Callback(val)
        end

        sliderBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                UpdateSlider(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                UpdateSlider(input)
            end
        end)
    end

    function Elements:CreateDropdown(data)
        local frame = Instance.new("Frame", TabContent)
        frame.Size = UDim2.new(1, -10, 0, 35)
        frame.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local label = Instance.new("TextLabel", frame)
        label.Text = "  " .. data.Name
        label.Size = UDim2.new(0.5, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(220, 220, 220)
        label.Font = Enum.Font.SourceSans
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left

        local btn = Instance.new("TextButton", frame)
        btn.Size = UDim2.new(0.45, 0, 0.7, 0)
        btn.Position = UDim2.new(0.52, 0, 0.15, 0)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
        btn.Text = data.Options[1] or "Select"
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 12
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        local currentIndex = 1
        btn.MouseButton1Click:Connect(function()
            currentIndex = currentIndex + 1
            if currentIndex > #data.Options then currentIndex = 1 end
            local selected = data.Options[currentIndex]
            btn.Text = selected
            data.Callback(selected)
        end)
    end

    function Elements:CreateParagraph(data)
        local frame = Instance.new("Frame", TabContent)
        frame.Size = UDim2.new(1, -10, 0, 45)
        frame.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local title = Instance.new("TextLabel", frame)
        title.Text = "  " .. data.Title
        title.Size = UDim2.new(1, 0, 0, 20)
        title.BackgroundTransparency = 1
        title.TextColor3 = Color3.fromRGB(255, 215, 0)
        title.Font = Enum.Font.SourceSansBold
        title.TextSize = 14
        title.TextXAlignment = Enum.TextXAlignment.Left

        local content = Instance.new("TextLabel", frame)
        content.Text = "  " .. data.Content
        content.Size = UDim2.new(1, 0, 0, 20)
        content.Position = UDim2.new(0, 0, 0, 20)
        content.BackgroundTransparency = 1
        content.TextColor3 = Color3.fromRGB(180, 180, 180)
        content.Font = Enum.Font.SourceSans
        content.TextSize = 12
        content.TextXAlignment = Enum.TextXAlignment.Left
    end

    return Elements
end

