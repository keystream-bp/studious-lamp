-- Equip Helper
local function EquipWep()
    local chr = L.Character
    if not chr or chr:FindFirstChildOfClass("Tool") then return end
    for _, t in pairs(L.Backpack:GetChildren()) do
        if t:IsA("Tool") then
            local tt, tn = t:FindFirstChild("ToolTip") and t.ToolTip.Value or "", t.Name:lower()
            if (CFG.Wep:find("Võ") and (tt == "Melee" or tn:find("combat") or tn:find("step"))) or
               (CFG.Wep:find("Kiếm") and (tt == "Sword" or tn:find("sword") or tn:find("katana"))) or
               (CFG.Wep:find("Trái") and (tt == "Blox Fruit" or tn:find("fruit"))) or
               (CFG.Wep:find("Súng") and (tt == "Gun" or tn:find("gun"))) then
                chr.Humanoid:EquipTool(t) break
            end
        end
    end
end

-- ESP Loop
S.RenderStepped:Connect(function()
    for _, p in pairs(P:GetPlayers()) do
        if p ~= L and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local chr, hrp, hum = p.Character, p.Character.HumanoidRootPart, p.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end

            local hl = chr:FindFirstChild("J_HL")
            if CFG.Box then
                if not hl then hl = Instance.new("Highlight", chr) hl.Name, hl.FillColor, hl.FillTransparency = "J_HL", Color3.fromRGB(255, 0, 50), 0.6 end
                hl.Enabled = true
            elseif hl then hl.Enabled = false end

            local bg = hrp:FindFirstChild("J_BG")
            if CFG.Name or CFG.Dist or CFG.HP then
                if not bg then
                    bg = Instance.new("BillboardGui", hrp) bg.Name, bg.Size, bg.AlwaysOnTop, bg.StudsOffset = "J_BG", UDim2.new(0, 180, 0, 50), true, Vector3.new(0, 3, 0)
                    local txt = Instance.new("TextLabel", bg) txt.Name, txt.Size, txt.BackgroundTransparency, txt.TextColor3, txt.Font = "Txt", UDim2.new(1, 0, 0, 20), 1, Color3.fromRGB(0, 255, 255), Enum.Font.SourceSansBold
                    local bar = Instance.new("Frame", bg) bar.Name, bar.Size, bar.Position, bar.BackgroundColor3 = "BarBG", UDim2.new(0.8, 0, 0, 5), UDim2.new(0.1, 0, 0.6, 0), Color3.fromRGB(40,40,40)
                    local fill = Instance.new("Frame", bar) fill.Name, fill.Size, fill.BackgroundColor3 = "Fill", UDim2.new(1, 0, 1, 0), Color3.fromRGB(0, 255, 100)
                end
                bg.Enabled = true
                bg.Txt.Text = (CFG.Name and p.Name or "") .. (CFG.Dist and L.Character and L.Character:FindFirstChild("HumanoidRootPart") and (" ["..math.floor((hrp.Position - L.Character.HumanoidRootPart.Position).Magnitude).."m]") or "")
                bg.BarBG.Visible = CFG.HP
                if CFG.HP then
                    local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    bg.BarBG.Fill.Size = UDim2.new(pct, 0, 1, 0)
                    bg.BarBG.Fill.BackgroundColor3 = Color3.fromRGB(255 * (1 - pct), 255 * pct, 50)
                end
            elseif bg then bg.Enabled = false end
        end
    end
end)

-- Auto Attack / Reach Engine
task.spawn(function()
    while task.wait(0.03) do
        if CFG.Click or CFG.Farm then
            pcall(function()
                EquipWep()
                local tool = L.Character and L.Character:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
            end)
        end
        if (CFG.Farm or CFG.Reach) and Net then
            pcall(function()
                local hrp = L.Character and L.Character:FindFirstChild("HumanoidRootPart")
                local tool = L.Character and L.Character:FindFirstChildOfClass("Tool")
                if not hrp or not tool then return end
                
                local hits, reach = {}, CFG.Reach and CFG.ReachDist or 60
                for _, e in pairs(workspace.Enemies:GetChildren()) do
                    if e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 and e:FindFirstChild("HumanoidRootPart") then
                        if (e.HumanoidRootPart.Position - hrp.Position).Magnitude <= reach then table.insert(hits, e.HumanoidRootPart) end
                    end
                end
                if #hits > 0 then Net:FireServer("RegisterHit", tool:FindFirstChild("Handle") or hrp, hits) end
            end)
        end
    end
end)

-- Auto Farm
task.spawn(function()
    while task.wait(0.1) do
        if CFG.Farm then
            pcall(function()
                local hrp = L.Character and L.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local lvl = L.Data.Level.Value
                local q = Quests[1]
                for _, v in ipairs(Quests) do if lvl >= v[1] then q = v end end
                
                local qUI = L.PlayerGui.Main:FindFirstChild("Quest")
                if not (qUI and qUI.Visible) then
                    hrp.CFrame = CFrame.new(q[4] + Vector3.new(0,3,0))
                    if (hrp.Position - q[4]).Magnitude < 10 then R.Remotes.CommF_:InvokeServer("StartQuest", q[2], 1) end
                else
                    local target = workspace.Enemies:FindFirstChild(q[3])
                    if target and target:FindFirstChild("HumanoidRootPart") and target.Humanoid.Health > 0 then
                        hrp.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 9, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        hrp.Velocity = Vector3.zero
                        if CFG.Bring then
                            for _, m in pairs(workspace.Enemies:GetChildren()) do
                                if m.Name == q[3] and m:FindFirstChild("HumanoidRootPart") and m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0 then
                                    if (m.HumanoidRootPart.Position - target.HumanoidRootPart.Position).Magnitude <= 200 then
                                        m.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame
                                        m.HumanoidRootPart.CanCollide = false
                                    end
                                end
                            end
                        end
                    else
                        hrp.CFrame = CFrame.new(q[5] + Vector3.new(0, 15, 0))
                    end
                end
            end)
        end
    end
end)
