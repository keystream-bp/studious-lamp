-- UI Helper
local function AddToggle(txt, cfgKey)
    local f = Instance.new("Frame", Content)
    f.Size, f.BackgroundColor3 = UDim2.new(1, 0, 0, 32), Color3.fromRGB(30, 30, 38)
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    
    local l = Instance.new("TextLabel", f)
    l.Text, l.Size, l.BackgroundTransparency, l.TextColor3, l.Font, l.TextXAlignment = "  "..txt, UDim2.new(0.7, 0, 1, 0), 1, Color3.fromRGB(220, 220, 220), Enum.Font.SourceSans, Enum.TextXAlignment.Left
    
    local b = Instance.new("TextButton", f)
    b.Size, b.Position, b.Text, b.Font, b.TextColor3 = UDim2.new(0, 45, 0, 22), UDim2.new(1, -50, 0.5, -11), CFG[cfgKey] and "ON" or "OFF", Enum.Font.SourceSansBold, Color3.fromRGB(255, 255, 255)
    b.BackgroundColor3 = CFG[cfgKey] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 70)
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    
    b.MouseButton1Click:Connect(function()
        CFG[cfgKey] = not CFG[cfgKey]
        b.Text = CFG[cfgKey] and "ON" or "OFF"
        b.BackgroundColor3 = CFG[cfgKey] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 70)
    end)
end

local function AddDropdown(txt, opts, callback)
    local f = Instance.new("Frame", Content)
    f.Size, f.BackgroundColor3 = UDim2.new(1, 0, 0, 32), Color3.fromRGB(30, 30, 38)
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    
    local l = Instance.new("TextLabel", f)
    l.Text, l.Size, l.BackgroundTransparency, l.TextColor3, l.Font, l.TextXAlignment = "  "..txt, UDim2.new(0.4, 0, 1, 0), 1, Color3.fromRGB(220, 220, 220), Enum.Font.SourceSans, Enum.TextXAlignment.Left
    
    local b = Instance.new("TextButton", f)
    b.Size, b.Position, b.Text, b.Font, b.TextColor3 = UDim2.new(0.55, 0, 0.7, 0), UDim2.new(0.42, 0, 0.15, 0), opts[1], Enum.Font.SourceSansBold, Color3.fromRGB(255, 255, 255)
    b.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    
    local idx = 1
    b.MouseButton1Click:Connect(function()
        idx = idx % #opts + 1
        b.Text = opts[idx]
        callback(opts[idx])
    end)
end

