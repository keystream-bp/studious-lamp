                            txt.Name, txt.Size, txt.BackgroundTransparency, txt.TextColor3, txt.TextSize, txt.Font, txt.TextStrokeTransparency = "Txt", UDim2.new(1, 0, 1, 0), 1, Color3.fromRGB(255, 170, 0), 14, Enum.Font.SourceSansBold, 0
                        end
                        bg.Txt.Text, bg.Enabled = "🍎 " .. v.Name .. (myHrp and (" [" .. math.floor((handle.Position - myHrp.Position).Magnitude) .. "m]") or ""), true
