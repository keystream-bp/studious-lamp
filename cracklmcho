-- Hàm Tự Động Trang Bị Vũ Khí
local function EquipWeapon()
    if not getgenv().AutoEquip or not LP.Character then return end
    local backpack = LP.Backpack
    for _, item in pairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            if (getgenv().SelectWeapon == "Melee" and item.ToolTip == "Melee") or
               (getgenv().SelectWeapon == "Sword" and item.ToolTip == "Sword") or
               (getgenv().SelectWeapon == "Blox Fruit" and item.ToolTip == "Blox Fruit") then
                LP.Character.Humanoid:EquipTool(item)
                break
            end
        end
    end
end

