local function ApplyEsp(obj, color, nameText)
    if not obj or not obj:IsDescendantOf(workspace) then return end
    if obj:FindFirstChild("JollibeeEsp") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "JollibeeEsp"
    highlight.FillColor = color
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0
    highlight.Adornee = obj
    highlight.Parent = obj

    local targetPart = obj:IsA("Model") and (obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart) or obj
    if targetPart then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "JollibeeEspTag"
        billboard.Adornee = targetPart
        billboard.Size = UDim2.new(0, 150, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true

        local label = Instance.new("TextLabel")
        label.Name = "Label"
        label.Parent = billboard
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.TextColor3 = color
        label.TextSize = 14
        label.Font = Enum.Font.SourceSansBold
        label.Text = nameText

        billboard.Parent = obj
    end
end

local function RemoveEsp(obj)
    if obj:FindFirstChild("JollibeeEsp") then obj.JollibeeEsp:Destroy() end
    if obj:FindFirstChild("JollibeeEspTag") then obj.JollibeeEspTag:Destroy() end
end

