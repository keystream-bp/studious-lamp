-- Loop ESP General
task.spawn(function()
    while task.wait(1) do
        if getgenv().EspPlayer then
            pcall(function()
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        ApplyEsp(p.Character, Color3.fromRGB(0, 255, 128), p.Name)
                    end
                end
            end)
        end
        if getgenv().EspMob then
            pcall(function()
                for _, mob in pairs(workspace.Enemies:GetChildren()) do
                    if mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                        ApplyEsp(mob, Color3.fromRGB(255, 50, 50), mob.Name)
                    end
                end
            end)
        end
        if getgenv().EspFruit then
            pcall(function()
                for _, obj in pairs(workspace:GetChildren()) do
                    if obj:IsA("Tool") or obj.Name:find("Fruit") then
                        ApplyEsp(obj, Color3.fromRGB(255, 0, 255), "Fruit: " .. obj.Name)
                    end
                end
            end)
        end
        if getgenv().EspChest then
            pcall(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj.Name:find("Chest1") or obj.Name:find("Chest2") or obj.Name:find("Chest3") then
                        ApplyEsp(obj, Color3.fromRGB(255, 215, 0), "Rương")
                    end
                end
            end)
        end
    end
end)

