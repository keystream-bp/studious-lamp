    end
end)

-- ESP Player Optimization
local ESP_Cache = {}

local function CreateESPForPlayer(plr)
    if plr == LP or ESP_Cache[plr] then return end
    local line, box, bg, txt = Drawing.new("Line"), Instance.new("Highlight"), Instance.new("BillboardGui"), Instance.new("TextLabel")
    line.Visible, line.Color, line.Thickness = false, Color3.fromRGB(0, 255, 255), 1.5
    box.Name, box.FillColor, box.OutlineColor, box.FillTransparency, box.Enabled = "ESP_Box", Color3.fromRGB(255, 50, 50), Color3.fromRGB(255, 255, 255), 0.5, false
    bg.Name, bg.Size, bg.AlwaysOnTop, bg.StudsOffset, bg.Enabled = "ESP_Text", UDim2.new(0, 200, 0, 50), true, Vector3.new(0, 3.5, 0), false
    txt.Parent, txt.Size, txt.BackgroundTransparency, txt.TextColor3, txt.TextSize, txt.Font, txt.TextStrokeTransparency = bg, UDim2.new(1, 0, 1, 0), 1, Color3.fromRGB(0, 255, 255), 13, Enum.Font.SourceSansBold, 0
    ESP_Cache[plr] = {Line = line, Box = box, Billboard = bg, TextLabel = txt}
end

local function RemoveESPForPlayer(plr)
    local data = ESP_Cache[plr]
    if data then
        pcall(function() data.Line:Remove() data.Box:Destroy() data.Billboard:Destroy() end)
        ESP_Cache[plr] = nil
    end
end

for _, plr in pairs(P:GetPlayers()) do CreateESPForPlayer(plr) end
P.PlayerAdded:Connect(CreateESPForPlayer)
P.PlayerRemoving:Connect(RemoveESPForPlayer)

RSvc.RenderStepped:Connect(function()
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for plr, data in pairs(ESP_Cache) do
        local char = plr.Character
        local pHrp, pHum = char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
        if char and pHrp and pHum and pHum.Health > 0 then
            if ESPBox then if data.Box.Parent ~= char then data.Box.Parent = char end data.Box.Enabled = true else data.Box.Enabled = false end
            if ESPName or ESPLevel or ESPHealth or ESPDist then
                if data.Billboard.Parent ~= pHrp then data.Billboard.Parent = pHrp end
                local info = (ESPName and plr.Name or "") .. (ESPLevel and " [Lv. " .. GetLvl(plr) .. "]" or "") .. (ESPHealth and "\nHP: " .. math.floor(pHum.Health) .. "/" .. math.floor(pHum.MaxHealth) or "") .. (ESPDist and myHrp and "\n[" .. math.floor((pHrp.Position - myHrp.Position).Magnitude) .. "m]" or "")
                data.TextLabel.Text, data.Billboard.Enabled = info, true
            else data.Billboard.Enabled = false end
            if ESPLine and myHrp then
                local pos, vis = Cam:WorldToViewportPoint(pHrp.Position)
                if vis then data.Line.From, data.Line.To, data.Line.Visible = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y), Vector2.new(pos.X, pos.Y), true else data.Line.Visible = false end
            else data.Line.Visible = false end
        else data.Box.Enabled, data.Billboard.Enabled, data.Line.Visible = false, false, false end
    end
end)

