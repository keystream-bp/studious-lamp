-- Hàm tạo ESP tổng hợp
local function CreateESP(player)
    local Box = Drawing.new("Square")
    local Name = Drawing.new("Text")
    local Health = Drawing.new("Text")
    local Line = Drawing.new("Line")

    RunService.RenderStepped:Connect(function()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 and player ~= LocalPlayer then
            local hrp = player.Character.HumanoidRootPart
            local head = player.Character:FindFirstChild("Head")
            
            if head then
                local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

                if onScreen then
                    local height = headPos.Y - legPos.Y
                    local width = height / 2

                    -- Box
                    Box.Visible = getgenv().EspBox
                    Box.Size = Vector2.new(width, height)
                    Box.Position = Vector2.new(hrpPos.X - width / 2, hrpPos.Y - height / 2)
                    Box.Color = Color3.fromRGB(255, 255, 255)

                    -- Name
                    Name.Visible = getgenv().EspName
                    Name.Text = player.Name
                    Name.Position = Vector2.new(hrpPos.X, hrpPos.Y - height / 2 - 15)
                    Name.Center = true
                    Name.Color = Color3.fromRGB(255, 255, 255)

                    -- Health
                    Health.Visible = getgenv().EspHealth
                    Health.Text = "HP: " .. math.floor(player.Character.Humanoid.Health)
                    Health.Position = Vector2.new(hrpPos.X, hrpPos.Y + height / 2 + 5)
                    Health.Center = true
                    Health.Color = Color3.fromRGB(0, 255, 100)

                    -- Line
                    Line.Visible = getgenv().EspLine
                    Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    Line.To = Vector2.new(hrpPos.X, hrpPos.Y)
                    Line.Color = Color3.fromRGB(255, 255, 255)

                    return
                end
            end
        end
        Box.Visible = false
        Name.Visible = false
        Health.Visible = false
        Line.Visible = false
    end)
end

for _, p in pairs(Players:GetPlayers()) do CreateESP(p) end
Players.PlayerAdded:Connect(CreateESP)

