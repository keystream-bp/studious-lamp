local function GetLvl(p)
    local target = p or LP
    local lvl = 1
    pcall(function() 
        if target:FindFirstChild("Data") and target.Data:FindFirstChild("Level") then lvl = target.Data.Level.Value
        elseif target:FindFirstChild("Level") then lvl = target.Level.Value end
    end)
    return lvl
end

local function GetQ()
    local l, c = GetLvl(), Quests[1]
    for _, q in ipairs(Quests) do if l >= q[1] then c = q end end
    return {QName = c[2], QNum = c[3], MName = c[4], Npc = c[5], Mob = c[6]}
end

local function FlyTo(targetCF)
    local chr = LP.Character
    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
    local hum = chr and chr:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local dist = (hrp.Position - targetCF.Position).Magnitude
    if dist > 6 then
        hum.PlatformStand = true
        for _, v in pairs(chr:GetChildren()) do if v:IsA("BasePart") then v.CanCollide = false end end
        if not CurPos or (CurPos - targetCF.Position).Magnitude > 5 then
            CurPos = targetCF.Position
            if CurTween then CurTween:Cancel() end
            CurTween = TS:Create(hrp, TweenInfo.new(dist / 250, Enum.EasingStyle.Linear), {CFrame = targetCF})
            CurTween:Play()
        end
    else
        if CurTween then CurTween:Cancel(); CurTween = nil end
        CurPos, hrp.CFrame, hum.PlatformStand = nil, targetCF, false
    end
end

local function StopFly()
    if CurTween then CurTween:Cancel(); CurTween = nil end
    CurPos = nil
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
end

-- Vòng lặp Auto Farm
RSvc.Heartbeat:Connect(function()
    if AutoFarm then
        pcall(function()
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            hrp.Velocity = Vector3.zero
            local q = GetQ()
            local qGui = LP.PlayerGui.Main:FindFirstChild("Quest")
            local hasQ = qGui and qGui.Visible and qGui.Container.QuestTitle.Title.Text ~= ""

            if not hasQ then
                if (hrp.Position - q.Npc.Position).Magnitude > 12 then FlyTo(q.Npc)
                else StopFly(); hrp.CFrame = q.Npc; RS.Remotes.CommF_:InvokeServer("StartQuest", q.QName, q.QNum) end
            else
                local mobList = {}
                if workspace:FindFirstChild("Enemies") then
                    for _, v in pairs(workspace.Enemies:GetChildren()) do
                        if (v.Name == q.MName or v.Name:find(q.MName)) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                            table.insert(mobList, {Mob = v, Dist = (v.HumanoidRootPart.Position - hrp.Position).Magnitude})
                        end
                    end
                end

                if #mobList == 0 then FlyTo(q.Mob)
                else
                    table.sort(mobList, function(a, b) return a.Dist < b.Dist end)
                    local mainMob = mobList[1].Mob
                    StopFly()
                    local mHrp = mainMob.HumanoidRootPart
                    hrp.CFrame = CFrame.new(mHrp.Position + Vector3.new(0, 10, 0), mHrp.Position)

                    if BringMob then
                        for i = 1, math.min(3, #mobList) do
                            local om = mobList[i].Mob
                            if om:FindFirstChild("HumanoidRootPart") then
                                om.HumanoidRootPart.CFrame = CFrame.new(mHrp.Position)
                                om.HumanoidRootPart.CanCollide = false
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- Vòng lặp Đánh Nhanh
task.spawn(function()
    while true do
        task.wait(FastAttack and 0.03 or 0.15)
        if AutoFarm then
            pcall(function()
                local chr = LP.Character
                if chr and chr:FindFirstChild("Humanoid") and chr.Humanoid.Health > 0 then
                    local tool = chr:FindFirstChildOfClass("Tool")
                    if not tool then
                        for _, t in pairs(LP.Backpack:GetChildren()) do
                            if t:IsA("Tool") then chr.Humanoid:EquipTool(t) break end
                        end
                    else
                        tool:Activate()
                        VU:Button1Down(Vector2.zero, Cam.CFrame) task.wait(0.01) VU:Button1Up(Vector2.zero, Cam.CFrame)
                    end
                end
            end)
        end
    end
end)

-- Logic ESP Player
local Lines = {}
RSvc.RenderStepped:Connect(function()
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for _, l in pairs(Lines) do pcall(function() l:Remove() end) end
    Lines = {}

    for _, p in pairs(P:GetPlayers()) do
        if p ~= LP and p.Character then
            local char = p.Character
            local pHrp = char:FindFirstChild("HumanoidRootPart")
            local pHum = char:FindFirstChildOfClass("Humanoid")

            if pHrp and pHum and pHum.Health > 0 then
                -- ESP Box (Highlight)
                local hl = char:FindFirstChild("JollibeeHL")
                if ESPBox then
                    if not hl then
                        hl = Instance.new("Highlight", char)
                        hl.Name = "JollibeeHL"
                        hl.FillColor = Color3.fromRGB(255, 50, 50)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    end
                    hl.Enabled = true
                elseif hl then hl.Enabled = false end

                -- ESP Name / Health / Distance
                local bg = pHrp:FindFirstChild("PlayerESP")
                if not bg then
                    bg = Instance.new("BillboardGui", pHrp)
                    bg.Name = "PlayerESP"; bg.Size = UDim2.new(0, 200, 0, 50); bg.AlwaysOnTop = true; bg.StudsOffset = Vector3.new(0, 3.5, 0)
                    local txt = Instance.new("TextLabel", bg)
                    txt.Name = "Txt"; txt.Size = UDim2.new(1, 0, 1, 0); txt.BackgroundTransparency = 1; txt.TextColor3 = Color3.fromRGB(0, 255, 255); txt.TextSize = 13; txt.Font = Enum.Font.SourceSansBold; txt.TextStrokeTransparency = 0
                end

                bg.Enabled = (ESPName or ESPDist or ESPHealth)
                if bg.Enabled then
                    local infoStr = ""
                    if ESPName then infoStr = infoStr .. p.Name end
                    if ESPHealth then infoStr = infoStr .. "\nHP: " .. math.floor(pHum.Health) .. "/" .. math.floor(pHum.MaxHealth) end
                    if ESPDist and myHrp then infoStr = infoStr .. "\n[" .. math.floor((pHrp.Position - myHrp.Position).Magnitude) .. "m]" end
                    bg.Txt.Text = infoStr
                end

                -- ESP Line (Đường kẻ)
                if ESPLine and myHrp then
                    local pos, vis = Cam:WorldToViewportPoint(pHrp.Position)
                    if vis then
                        local l = Drawing.new("Line")
                        l.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
                        l.To = Vector2.new(pos.X, pos.Y)
                        l.Color = Color3.fromRGB(0, 255, 255); l.Thickness = 1.5; l.Visible = true
                        table.insert(Lines, l)
                    end
                end
            end
        end
    end
end)

