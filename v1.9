local function TeleportToFruit()
    pcall(function()
        local fruits = {}
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Tool") or v.Name:find("Fruit") then
                local handle = v:FindFirstChild("Handle") or v:FindFirstChildWhichIsA("BasePart")
                if handle then table.insert(fruits, {Tool = v, Part = handle}) end
            end
        end
        if #fruits > 0 then
            local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if myHrp then
                table.sort(fruits, function(a, b) return (a.Part.Position - myHrp.Position).Magnitude < (b.Part.Position - myHrp.Position).Magnitude end)
                local target = fruits[1]
                task.spawn(function()
                    while target.Part and target.Part.Parent and (target.Part.Position - myHrp.Position).Magnitude > 5 do FlyTo(target.Part.CFrame, 300) task.wait(0.05) end
                    StopFly()
                    if target.Part and target.Part.Parent then myHrp.CFrame = target.Part.CFrame firetouchinterest(myHrp, target.Part, 0) task.wait(0.1) firetouchinterest(myHrp, target.Part, 1) end
                end)
            end
        end
    end)
end

RSvc.RenderStepped:Connect(function()
    pcall(function()
        local chr = LP.Character
        local hum, hrp = chr and chr:FindFirstChildOfClass("Humanoid"), chr and chr:FindFirstChild("HumanoidRootPart")
        if SpeedHack and hum then hum.WalkSpeed = WalkSpeedValue end
        if WalkOnWater and hrp then
            if not WaterPart or not WaterPart.Parent then
                WaterPart = Instance.new("Part", workspace)
                WaterPart.Name, WaterPart.Size, WaterPart.Anchored, WaterPart.Transparency, WaterPart.Color = "WaterPlatform", Vector3.new(300, 1, 300), true, 0.5, Color3.fromRGB(0, 170, 255)
            end
            WaterPart.CFrame = CFrame.new(hrp.Position.X, 0, hrp.Position.Z)
        elseif WaterPart then WaterPart:Destroy(); WaterPart = nil end
    end)
end)

