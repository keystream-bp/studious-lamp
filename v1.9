local function GetLvl(p) local target, lvl = p or LP, 1 pcall(function() lvl = target:FindFirstChild("Data") and target.Data.Level.Value or target.Level.Value end) return lvl end
local function GetQ() local l, c = GetLvl(), Quests[1] for _, q in ipairs(Quests) do if l >= q[1] then c = q end end return {QName = c[2], QNum = c[3], MName = c[4], Npc = c[5], Mob = c[6]} end

local function FlyTo(targetCF, speed)
    speed = speed or 250
    local chr = LP.Character
    local hrp, hum = chr and chr:FindFirstChild("HumanoidRootPart"), chr and chr:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    local dist = (hrp.Position - targetCF.Position).Magnitude
    if dist > 6 then
        hum.PlatformStand = true
        for _, v in pairs(chr:GetChildren()) do if v:IsA("BasePart") then v.CanCollide = false end end
        if not CurPos or (CurPos - targetCF.Position).Magnitude > 5 then
            CurPos = targetCF.Position
            if CurTween then CurTween:Cancel() end
            CurTween = TS:Create(hrp, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), {CFrame = targetCF})
            CurTween:Play()
        end
    else
        if CurTween then CurTween:Cancel(); CurTween = nil end
        CurPos, hrp.CFrame, hum.PlatformStand = nil, targetCF, false
    end
end

local function StopFly()
    if CurTween then CurTween:Cancel(); CurTween = nil end
    CurPos = nil
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
end

-- Vòng lặp Tấn công đã SỬA LỖI UI
task.spawn(function()
    while true do
        if AutoFarm or AutoBones or AutoKatakuri or AutoBoss then
            pcall(function()
                local chr = LP.Character
                if chr and chr:FindFirstChild("Humanoid") and chr.Humanoid.Health > 0 then
                    local tool = chr:FindFirstChildOfClass("Tool")
                    if not tool then
                        for _, t in pairs(LP.Backpack:GetChildren()) do
                            if t:IsA("Tool") and t.ToolTip ~= "Gun" then 
                                chr.Humanoid:EquipTool(t) 
                                break 
                            end 
                        end
                    else
                        -- Tấn công trực tiếp bằng Tool Activate không chạm vào UI
                        tool:Activate()
                        if RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("Net") then
                            pcall(function() RS.Modules.Net:FindFirstChild("RegisterAttack"):InvokeServer() end)
                        end
                        if FastDistance and tool:FindFirstChild("Handle") then 
                            tool.Handle.Size = Vector3.new(50, 50, 50)
                            tool.Handle.CanCollide = false 
                        end
                    end
                end
            end)
        end
        task.wait(FastAttack and 0.015 or 0.2)
    end
end)

RSvc.Heartbeat:Connect(function()
    if AutoFarm then
        pcall(function()
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            hrp.Velocity = Vector3.zero
            local q, qGui = GetQ(), LP.PlayerGui.Main:FindFirstChild("Quest")
            local hasQ = qGui and qGui.Visible and qGui.Container.QuestTitle.Title.Text ~= ""
            if not hasQ then
                if (hrp.Position - q.Npc.Position).Magnitude > 12 then FlyTo(q.Npc)
                else StopFly(); hrp.CFrame = q.Npc; RS.Remotes.CommF_:InvokeServer("StartQuest", q.QName, q.QNum) end
            else
                local mobList = {}
                if workspace:FindFirstChild("Enemies") then
                    for _, v in pairs(workspace.Enemies:GetChildren()) do
                        if (v.Name == q.MName or v.Name:find(q.MName)) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                            table.insert(mobList, {Mob = v, Dist = (v.HumanoidRootPart.Position - hrp.Position).Magnitude})
                        end
                    end
                end
                if #mobList == 0 then FlyTo(q.Mob)
                else
                    table.sort(mobList, function(a, b) return a.Dist < b.Dist end)
                    local mainMob = mobList[1].Mob
                    StopFly()
                    local mHrp = mainMob.HumanoidRootPart
                    hrp.CFrame = CFrame.new(mHrp.Position + Vector3.new(0, 10, 0), mHrp.Position)
                    if BringMob then
                        for i = 1, math.min(3, #mobList) do
                            local om = mobList[i].Mob
                            if om:FindFirstChild("HumanoidRootPart") then om.HumanoidRootPart.CFrame, om.HumanoidRootPart.CanCollide = CFrame.new(mHrp.Position), false end
                        end
                    end
                end
            end
        end)
    end
end)

