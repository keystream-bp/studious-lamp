-- Auto Farm Loop
RSvc.Heartbeat:Connect(function()
    if AutoFarm then
        pcall(function()
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            hrp.Velocity = Vector3.zero
            local q = GetQ()
            local qGui = LP.PlayerGui.Main:FindFirstChild("Quest")
            local hasQ = qGui and qGui.Visible and qGui.Container.QuestTitle.Title.Text ~= ""

            if not hasQ then
                if (hrp.Position - q.Npc.Position).Magnitude > 12 then FlyTo(q.Npc)
                else StopFly(); hrp.CFrame = q.Npc; RS.Remotes.CommF_:InvokeServer("StartQuest", q.QName, q.QNum) end
            else
                local mobList = {}
                if workspace:FindFirstChild("Enemies") then
                    for _, v in pairs(workspace.Enemies:GetChildren()) do
                        if (v.Name == q.MName or v.Name:find(q.MName)) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                            local dist = (v.HumanoidRootPart.Position - hrp.Position).Magnitude
                            table.insert(mobList, {Mob = v, Dist = dist})
                        end
                    end
                end

                if #mobList == 0 then FlyTo(q.Mob)
                else
                    table.sort(mobList, function(a, b) return a.Dist < b.Dist end)
                    local mainMob = mobList[1].Mob
                    StopFly()
                    local mHrp = mainMob.HumanoidRootPart
                    hrp.CFrame = CFrame.new(mHrp.Position + Vector3.new(0, 8, 0))

                    if BringMob then
                        for i = 1, math.min(3, #mobList) do
                            local om = mobList[i].Mob
                            local omHrp = om:FindFirstChild("HumanoidRootPart")
                            local omHum = om:FindFirstChild("Humanoid")
                            if omHrp and omHum then
                                omHrp.CFrame = CFrame.new(mHrp.Position)
                                omHrp.CanCollide = false
                                for _, part in pairs(om:GetChildren()) do
                                    if part:IsA("BasePart") then part.CanCollide = false end
                                end
                                omHum.WalkSpeed = 0
                            end
                        end
                    end
                end
            end
        end)
    end
end)

