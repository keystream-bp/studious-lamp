-- Helper UI Functions (Fix Tương Phản Màu Chữ Nổi Bật)
local function CreateToggle(parent, langKey, default, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, -10, 0, 32)
    btn.BackgroundColor3 = default and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(42, 42, 56)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    local state = default
    local function UpdateText()
        btn.Text = "   " .. LangText[CurrentLang][langKey] .. " : " .. (state and "ON" or "OFF")
    end
    UpdateText()

    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 90) or Color3.fromRGB(42, 42, 56)
        UpdateText()
        callback(state)
    end)

    table.insert(UI_Elements, UpdateText)
end

local function CreateButton(parent, langKey, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, -10, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    local function UpdateText()
