-- TELEPORT VÀ AUTO NHẶT & CẤT TRÁI ÁC QUỶ
local function TeleportToFruit()
    pcall(function()
        local fruitsFound = {}
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Tool") or v.Name:find("Fruit") or v.Name:find("Fruit ") then
                local handle = v:FindFirstChild("Handle") or v:FindFirstChildWhichIsA("BasePart")
                if handle then table.insert(fruitsFound, {Tool = v, Part = handle}) end
            end
        end

        if #fruitsFound > 0 then
            local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if myHrp then
                table.sort(fruitsFound, function(a, b) return (a.Part.Position - myHrp.Position).Magnitude < (b.Part.Position - myHrp.Position).Magnitude end)
                local target = fruitsFound[1]
                
                Fluent:Notify({
                    Title = "Jollibee Hub",
                    Content = "Đang bay tới trái: " .. target.Tool.Name,
                    Duration = 3
                })
                
                task.spawn(function()
                    while target.Part and target.Part.Parent and (target.Part.Position - myHrp.Position).Magnitude > 5 do
                        FlyTo(target.Part.CFrame, 300)
                        task.wait(0.05)
                    end
                    StopFly()
                    if target.Part and target.Part.Parent then
                        myHrp.CFrame = target.Part.CFrame
                        firetouchinterest(myHrp, target.Part, 0) task.wait(0.1) firetouchinterest(myHrp, target.Part, 1)
                    end

                    if AutoStoreFruit then
                        task.wait(0.5)
                        pcall(function()
                            for _, tool in pairs(LP.Backpack:GetChildren()) do
                                if tool:IsA("Tool") and (tool.Name:find("Fruit") or tool.Name:find("Fruit ")) then
                                    RS.Remotes.CommF_:InvokeServer("StoreFruit", tool.Name, tool)
                                end
                            end
                        end)
                    end
                end)
            end
        else
            Fluent:Notify({
                Title = "Jollibee Hub",
                Content = "Không tìm thấy Trái Ác Quỷ nào trên sàn!",
                Duration = 3
            })
        end
    end)
end

-- ESP PLAYER LOGIC
local Lines = {}
RSvc.RenderStepped:Connect(function()
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for _, l in pairs(Lines) do pcall(function() l:Remove() end) end
    Lines = {}

    for _, p in pairs(P:GetPlayers()) do
        if p ~= LP and p.Character then
            local char = p.Character
            local pHrp = char:FindFirstChild("HumanoidRootPart")
            local pHum = char:FindFirstChildOfClass("Humanoid")

            if pHrp and pHum and pHum.Health > 0 then
                local hl = char:FindFirstChild("JollibeeHL")
                if ESPBox then
                    if not hl then
                        hl = Instance.new("Highlight", char)
                        hl.Name = "JollibeeHL"
                        hl.FillColor = Color3.fromRGB(255, 50, 50)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    end
                    hl.Enabled = true
                elseif hl then hl.Enabled = false end

                local bg = pHrp:FindFirstChild("PlayerESP")
                if not bg then
                    bg = Instance.new("BillboardGui", pHrp)
                    bg.Name = "PlayerESP"; bg.Size = UDim2.new(0, 200, 0, 50); bg.AlwaysOnTop = true; bg.StudsOffset = Vector3.new(0, 3.5, 0)
                    local txt = Instance.new("TextLabel", bg)
                    txt.Name = "Txt"; txt.Size = UDim2.new(1, 0, 1, 0); txt.BackgroundTransparency = 1; txt.TextColor3 = Color3.fromRGB(0, 255, 255); txt.TextSize = 13; txt.Font = Enum.Font.SourceSansBold; txt.TextStrokeTransparency = 0
                end

                bg.Enabled = (ESPName or ESPDist or ESPLevel or ESPHealth)
                if bg.Enabled then
                    local infoStr = ""
                    if ESPName then infoStr = infoStr .. p.Name end
                    if ESPLevel then infoStr = infoStr .. " [Lv. " .. GetLvl(p) .. "]" end
                    if ESPHealth then infoStr = infoStr .. "\nHP: " .. math.floor(pHum.Health) .. "/" .. math.floor(pHum.MaxHealth) end
                    if ESPDist and myHrp then infoStr = infoStr .. "\n[" .. math.floor((pHrp.Position - myHrp.Position).Magnitude) .. "m]" end
                    bg.Txt.Text = infoStr
                end

                if ESPLine and myHrp then
                    local pos, vis = Cam:WorldToViewportPoint(pHrp.Position)
                    if vis then
                        local l = Drawing.new("Line")
                        l.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
                        l.To = Vector2.new(pos.X, pos.Y)
                        l.Color = Color3.fromRGB(0, 255, 255); l.Thickness = 1.5; l.Visible = true
                        table.insert(Lines, l)
                    end
                end
            end
        end
    end
end)

