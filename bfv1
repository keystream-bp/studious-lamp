-- Simplified World ESP (Fruit/Chest)
task.spawn(function()
    while task.wait(0.5) do
        for _, o in pairs(workspace:GetDescendants()) do
            local name = string.lower(o.Name)
            local isChest = o:IsA("Model") and (name:find("chest") or name:find("rương"))
            local isFruit = (o:IsA("Tool") or o:IsA("Model")) and (name:find("fruit") or name:find("trái")) and not o:FindFirstAncestorOfClass("Model"):FindFirstChild("Humanoid")
            local part = o:IsA("BasePart") and o or o:FindFirstChildWhichIsA("BasePart")
            if part then
                local gui = part:FindFirstChild("JollibeeESP")
                if (ESPChest and isChest) or (ESPFruit and isFruit) then
                    if not gui then
                        gui = Instance.new("BillboardGui", part)
                        gui.Name, gui.Size, gui.AlwaysOnTop = "JollibeeESP", UDim2.new(0, 150, 0, 30), true
                        local t = Instance.new("TextLabel", gui)
                        t.Size, t.BackgroundTransparency, t.TextColor3, t.Font, t.TextSize = UDim2.new(1, 0, 1, 0), 1, isChest and Color3.new(1, 0.8, 0) or Color3.new(1, 0.4, 0.7), Enum.Font.SourceSansBold, 12
                    end
                    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then gui.TextLabel.Text = (isChest and "📦 " or "🍎 ") .. o.Name .. "\n[" .. math.floor((part.Position - hrp.Position).Magnitude) .. "m]" end
                elseif gui then gui:Destroy() end
                
            end
        end
    end
end)

-- Render Loop & Player ESP
RS.RenderStepped:Connect(function()
    local chr = LP.Character
    local hrp, hum = chr and chr:FindFirstChild("HumanoidRootPart"), chr and chr:FindFirstChildOfClass("Humanoid")
    if FlyEnabled and hrp and hum then
        hum.PlatformStand = true
        hrp.Velocity = hum.MoveDirection.Magnitude > 0 and (Cam.CFrame.LookVector * -hum.MoveDirection.Z + Cam.CFrame.RightVector * hum.MoveDirection.X).Unit * FlySpeed or Vector3.zero
    elseif hum and not FlyEnabled and not AutoFarm then hum.PlatformStand = false end

    for _, l in pairs(Lines) do l:Remove() end Lines = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pHrp = p.Character.HumanoidRootPart
            local hl = p.Character:FindFirstChild("HL") or Instance.new("Highlight", p.Character)
            hl.Name, hl.Enabled, hl.FillColor = "HL", ESPBox, Color3.new(1, 0, 0)
            
            if ESPLine and hrp then
                local pos, onS = Cam:WorldToViewportPoint(pHrp.Position)
                if onS then
                    local l = Drawing.new("Line")
                    l.From, l.To, l.Color, l.Thickness, l.Visible = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y), Vector2.new(pos.X, pos.Y), Color3.new(1, 1, 1), 1, true
                    table.insert(Lines, l)
                end
            end
        end
    end
end)

