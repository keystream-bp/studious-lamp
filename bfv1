local function GetQuest()
    local lvl, curr = LP.Data.Level.Value, QuestData[1]
    for _, q in ipairs(QuestData) do if lvl >= q[1] then curr = q end end
    return curr
end

local function FlyTo(cf)
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (hrp.Position - cf.Position).Magnitude
    if dist > 15 then
        if CurrentTween then CurrentTween:Cancel() end
        CurrentTween = TS:Create(hrp, TweenInfo.new(dist / 250, Enum.EasingStyle.Linear), {CFrame = cf})
        CurrentTween:Play()
    else hrp.CFrame = cf end
end

-- Fast Attack & RegisterHit Core Engine
local NetEvent = Rep:FindFirstChild("RigControllerEvent") or Rep.Remotes:FindFirstChild("Validator") or Rep.Remotes:FindFirstChild("CommE")
task.spawn(function()
    while task.wait(0.01) do
        if (AutoFarm or FastAtk) and pcall(function()
            if AntiMiss and math.random(1, 100) <= 12 then task.wait(0.05) return end
            local chr = LP.Character
            local tool, hrp = chr:FindFirstChildOfClass("Tool"), chr:FindFirstChild("HumanoidRootPart")
            if not tool or not hrp then
                for _, t in pairs(LP.Backpack:GetChildren()) do if t:IsA("Tool") then chr.Humanoid:EquipTool(t) break end end
                return
            end
            tool:Activate()
            local hits = {}
            for _, e in pairs(workspace.Enemies:GetChildren()) do
                if e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 and e:FindFirstChild("HumanoidRootPart") then
                    if (e.HumanoidRootPart.Position - hrp.Position).Magnitude <= 65 then table.insert(hits, e.HumanoidRootPart) end
                end
            end
            if #hits > 0 and NetEvent then NetEvent:FireServer("RegisterHit", tool:FindFirstChild("Handle") or hrp, hits) end
        end) then end
    end
end)

-- Main Farm Loop
task.spawn(function()
    while task.wait(0.1) do
        if AutoFarm and pcall(function()
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local q = GetQuest()
            local qUI = LP.PlayerGui.Main:FindFirstChild("Quest")
            if not (qUI and qUI.Visible) then
                FlyTo(CFrame.new(q[4] + Vector3.new(0, 3, 0)))
                if (hrp.Position - q[4]).Magnitude < 10 then Rep.Remotes.CommF_:InvokeServer("StartQuest", q[2], 1) end
            else
                local mob, minD = nil, math.huge
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v.Name == q[3] and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        local d = (v.HumanoidRootPart.Position - hrp.Position).Magnitude
                        if d < minD then minD = d mob = v end
                    end
                end
                if not mob then FlyTo(CFrame.new(q[5] + Vector3.new(0, 12, 0)))
                else
                    local mHrp = mob.HumanoidRootPart
                    hrp.CFrame = mHrp.CFrame * CFrame.new(0, 9, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                    hrp.Velocity = Vector3.zero
                    if BringMob or AutoFarm then
                        for _, o in pairs(workspace.Enemies:GetChildren()) do
                            if o.Name == q[3] and o:FindFirstChild("HumanoidRootPart") and o:FindFirstChild("Humanoid") and o.Humanoid.Health > 0 then
                                if (o.HumanoidRootPart.Position - mHrp.Position).Magnitude <= 300 then
                                    o.HumanoidRootPart.CFrame, o.HumanoidRootPart.CanCollide, o.Humanoid.WalkSpeed = mHrp.CFrame, false, 0
                                end
                            end
                        end
                    end
                end
            end
        end) then end
    end
end)

