-- HỆ THỐNG ESP PLAYER
local ESP_Cache = {}

local function CreateESPForPlayer(plr)
    if plr == LP or ESP_Cache[plr] then return end
    local espData = {
        Line = Drawing.new("Line"),
        Box = Instance.new("Highlight"),
        Billboard = Instance.new("BillboardGui"),
        TextLabel = Instance.new("TextLabel")
    }
    
    espData.Line.Visible = false
    espData.Line.Color = Color3.fromRGB(0, 255, 255)
    espData.Line.Thickness = 1.5

    espData.Box.Name = "Jollibee_ESP_Box"
    espData.Box.FillColor = Color3.fromRGB(255, 50, 50)
    espData.Box.OutlineColor = Color3.fromRGB(255, 255, 255)
    espData.Box.FillTransparency = 0.5
    espData.Box.Enabled = false

    espData.Billboard.Name = "Jollibee_ESP_Text"
    espData.Billboard.Size = UDim2.new(0, 200, 0, 50)
    espData.Billboard.AlwaysOnTop = true
    espData.Billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    espData.Billboard.Enabled = false

    espData.TextLabel.Parent = espData.Billboard
    espData.TextLabel.Size = UDim2.new(1, 0, 1, 0)
    espData.TextLabel.BackgroundTransparency = 1
    espData.TextLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
    espData.TextLabel.TextSize = 13
    espData.TextLabel.Font = Enum.Font.SourceSansBold
    espData.TextLabel.TextStrokeTransparency = 0

    ESP_Cache[plr] = espData
end

local function RemoveESPForPlayer(plr)
    local data = ESP_Cache[plr]
    if data then
        pcall(function() data.Line:Remove() end)
        pcall(function() data.Box:Destroy() end)
        pcall(function() data.Billboard:Destroy() end)
        ESP_Cache[plr] = nil
    end
end

for _, plr in pairs(P:GetPlayers()) do CreateESPForPlayer(plr) end
P.PlayerAdded:Connect(CreateESPForPlayer)
P.PlayerRemoving:Connect(RemoveESPForPlayer)

RSvc.RenderStepped:Connect(function()
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    
    for plr, data in pairs(ESP_Cache) do
        local char = plr.Character
        local pHrp = char and char:FindFirstChild("HumanoidRootPart")
        local pHum = char and char:FindFirstChildOfClass("Humanoid")

        if char and pHrp and pHum and pHum.Health > 0 then
            if ESPBox then
                if data.Box.Parent ~= char then data.Box.Parent = char end
                data.Box.Enabled = true
            else
                data.Box.Enabled = false
            end

            if ESPName or ESPLevel or ESPHealth or ESPDist then
                if data.Billboard.Parent ~= pHrp then data.Billboard.Parent = pHrp end
                local infoStr = ""
                if ESPName then infoStr = infoStr .. plr.Name end
                if ESPLevel then infoStr = infoStr .. " [Lv. " .. GetLvl(plr) .. "]" end
                if ESPHealth then infoStr = infoStr .. "\nHP: " .. math.floor(pHum.Health) .. "/" .. math.floor(pHum.MaxHealth) end
                if ESPDist and myHrp then infoStr = infoStr .. "\n[" .. math.floor((pHrp.Position - myHrp.Position).Magnitude) .. "m]" end
                
                data.TextLabel.Text = infoStr
                data.Billboard.Enabled = true
            else
                data.Billboard.Enabled = false
            end

            if ESPLine and myHrp then
                local pos, vis = Cam:WorldToViewportPoint(pHrp.Position)
                if vis then
                    data.Line.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
                    data.Line.To = Vector2.new(pos.X, pos.Y)
                    data.Line.Visible = true
                else
                    data.Line.Visible = false
                end
            else
                data.Line.Visible = false
            end
        else
            data.Box.Enabled = false
            data.Billboard.Enabled = false
            data.Line.Visible = false
        end
    end
end)

