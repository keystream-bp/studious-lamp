-- Bypass Anti-Cheat & Bảo vệ Script
pcall(function()
    local g = getgenv and getgenv() or _G
    if g.debug then g.debug.info, g.debug.getupvalue, g.debug.getconstant = function() end, function() end, function() end end
    local hook = hookmetamethod or detach
    if hook then
        local oldIdx, oldNc
        oldIdx = hook(game, "__index", function(self, k)
            return (not checkcaller() and (k == "WalkSpeed" or k == "JumpPower")) and 16 or oldIdx(self, k)
        end)
        oldNc = hook(game, "__namecall", function(self, ...)
            local m, n = getnamecallmethod(), tostring(self.Name):lower()
            if (m == "FireServer" or m == "InvokeServer") and (n:find("ban") or n:find("cheat") or n:find("validator")) then return nil end
            return oldNc(self, ...)
        end)
    end
end)

