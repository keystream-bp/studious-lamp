local CombatFramework = require(LP.PlayerScripts:WaitForChild("CombatFramework", 2))
local CombatFrameworkLib = getupvalues(CombatFramework)[2]

local function AttackNoCD()
    pcall(function()
        local chr = LP.Character
        if not chr then return end
        
        -- Auto Equip Weapon
        local tool = chr:FindFirstChildOfClass("Tool")
        if not tool then
            for _, t in pairs(LP.Backpack:GetChildren()) do
                if t:IsA("Tool") and ((SelectedWeapon == "Melee" and t.ToolTip == "Melee") or
                   (SelectedWeapon == "Sword" and t.ToolTip == "Sword") or
                   (SelectedWeapon == "Blox Fruit" and t.ToolTip == "Blox Fruit")) then
                    chr.Humanoid:EquipTool(t)
                    break
                end
            end
        else
            -- Bypass Animation & CD
            tool:Activate()
            if FastAttack then
                local activeController = CombatFrameworkLib.activeController
                if activeController then
                    activeController.timeToNextAttack = 0
                    activeController.hitboxMagnitude = FastDistance and 60 or 25
                    activeController:attack()
                end
            end
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(FastAttack and 0.001 or 0.1)
        if AutoFarm then
            AttackNoCD()
        end
    end
end)

